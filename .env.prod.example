# ==============================================================================
# StackStorm Production Environment Variables Template
# Copy this file to .env on your VPS inside the infra/ directory:
#   cp .env.prod.example .env
# Replace all placeholder values with your real production secrets.
# ==============================================================================

# Database (PostgreSQL 17)
POSTGRES_DB=stackstorm_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_db_password

# Redis Cache & Sessions (Redis 7)
REDIS_URL=redis://redis:6379

# Application Environment
NODE_ENV=production
PORT=5000
DATABASE_SSL=false

# Authentication & Security
JWT_SECRET=replace_with_long_random_64_character_jwt_secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_WORK_FACTOR=12

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_live_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_signing_secret

# Email Dispatch (SendGrid)
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@dickwellafashion.lk

# Cloud Media & Image Storage (AWS S3)
AWS_S3_BUCKET=stackstorm-prod-uploads
AWS_ACCESS_KEY_ID=replace_with_aws_access_key
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_key
AWS_REGION=ap-south-1

# CORS Allowed Client Domains
FRONTEND_URL=http://your-vps-ip-or-domain.com
ADMIN_URL=http://your-vps-ip-or-domain.com:8080

# Logging
LOG_LEVEL=info
